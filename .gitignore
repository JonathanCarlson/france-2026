# NEVER commit the plaintext trip data — only the encrypted blob (data/itinerary.enc.json) ships.
build/itinerary.json
# Plaintext ticket PDFs/images — only the encrypted data/tickets/*.enc ship.
build/tickets/
# Plaintext trip photos — only the encrypted data/photos/*.enc ship.
build/photos/

# Secrets
.env
*.local
TRIP_PASSPHRASE*
# Album access key — the friends-album URL token. Kept out of git so the shared
# link isn't leaked in history; build/build-album.mjs reads/creates it locally.
build/album-key.txt

# NEVER commit the plaintext car list — only the encrypted blob (data/cars.enc.json) ships.
build/cars.json
# Car access key — the Kate-shareable cars-page URL token. Kept out of git so the
# shared link isn't leaked in history; build/build-cars.mjs reads/creates it locally.
build/cars-key.txt

# NEVER commit the plaintext teen-car list — only the encrypted blob (data/jordyn.enc.json) ships.
build/jordyn.json
# Jordyn access key — the shareable jordyn-page URL token. Kept out of git so the
# shared link isn't leaked in history; build/build-jordyn.mjs reads/creates it locally.
build/jordyn-key.txt

# Face-recognition working dir — ONNX models (37MB), Python venv artifacts, scratch scripts
build/facerec/

# Node / OS
node_modules/
.DS_Store
Thumbs.db
